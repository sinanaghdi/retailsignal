table FactSalesLine

	measure 'Net Recorded Sales GBP' = SUM ( FactSalesLine[line_value] )
		formatString: £#,##0.00;[Red]-£#,##0.00;£0.00

	measure 'Gross Positive Line Sales GBP' = CALCULATE ( SUM ( FactSalesLine[line_value] ), FactSalesLine[is_positive_sales_line] = TRUE () )
		formatString: £#,##0.00;[Red]-£#,##0.00;£0.00

	measure 'Negative Line Value Magnitude GBP' = SUMX ( FILTER ( FactSalesLine, FactSalesLine[line_value] < 0 ), -FactSalesLine[line_value] )
		formatString: £#,##0.00;[Red]-£#,##0.00;£0.00

	measure 'Recorded Invoices' = CALCULATE ( DISTINCTCOUNT ( FactSalesLine[invoice_no] ), NOT ISBLANK ( FactSalesLine[invoice_no] ) )
		formatString: #,##0

	measure 'Eligible Sales Invoices' = CALCULATE ( DISTINCTCOUNT ( FactSalesLine[invoice_no] ), FactSalesLine[is_positive_sales_line] = TRUE (), NOT ISBLANK ( FactSalesLine[invoice_no] ) )
		formatString: #,##0

	measure 'Average Positive Invoice Value GBP' = DIVIDE ( [Gross Positive Line Sales GBP], [Eligible Sales Invoices] )
		formatString: £#,##0.00;[Red]-£#,##0.00;£0.00

	measure 'Cancellation-Prefixed Invoices' = CALCULATE ( DISTINCTCOUNT ( FactSalesLine[invoice_no] ), FactSalesLine[is_cancellation_invoice] = TRUE (), NOT ISBLANK ( FactSalesLine[invoice_no] ) )
		formatString: #,##0

	measure 'Negative Quantity Rows' = CALCULATE ( COUNTROWS ( FactSalesLine ), FactSalesLine[quantity] < 0 )
		formatString: #,##0

	measure 'Missing Customer ID Rows' = CALCULATE ( COUNTROWS ( FactSalesLine ), ISBLANK ( FactSalesLine[customer_id] ) )
		formatString: #,##0

	measure 'Missing Customer ID Row Share' = DIVIDE ( [Missing Customer ID Rows], COUNTROWS ( FactSalesLine ) )
		formatString: 0.0%;[Red]-0.0%;0.0%

	measure 'Exact Duplicate Candidate Extra Rows' = CALCULATE ( COUNTROWS ( FactSalesLine ), FactSalesLine[is_exact_duplicate_extra_row] = TRUE () )
		formatString: #,##0

	measure 'Identified Customers With Purchase' = COUNTROWS ( FILTER ( VALUES ( FactSalesLine[customer_id] ), NOT ISBLANK ( FactSalesLine[customer_id] ) && CALCULATE ( DISTINCTCOUNT ( FactSalesLine[invoice_no] ), FactSalesLine[is_positive_sales_line] = TRUE (), FactSalesLine[is_customer_analytics_eligible] = TRUE () ) > 0 ) )
		formatString: #,##0

	measure 'Repeat Customers' = COUNTROWS ( FILTER ( VALUES ( FactSalesLine[customer_id] ), NOT ISBLANK ( FactSalesLine[customer_id] ) && CALCULATE ( DISTINCTCOUNT ( FactSalesLine[invoice_no] ), FactSalesLine[is_positive_sales_line] = TRUE (), FactSalesLine[is_customer_analytics_eligible] = TRUE () ) >= 2 ) )
		formatString: #,##0

	measure 'Repeat-Purchase Customer Rate' = DIVIDE ( [Repeat Customers], [Identified Customers With Purchase] )
		formatString: 0.0%;[Red]-0.0%;0.0%

	measure 'Previous Month Net Recorded Sales GBP' = CALCULATE ( [Net Recorded Sales GBP], DATEADD ( 'Date'[Date], -1, MONTH ) )
		formatString: £#,##0.00;[Red]-£#,##0.00;£0.00

	measure 'MoM Net Recorded Sales Change %' = DIVIDE ( [Net Recorded Sales GBP] - [Previous Month Net Recorded Sales GBP], [Previous Month Net Recorded Sales GBP] )
		formatString: 0.0%;[Red]-0.0%;0.0%

	measure 'Top 10 Product Sales GBP' = VAR ProductRank = RANKX ( ALL ( DimProduct[stock_code] ), [Gross Positive Line Sales GBP], , DESC, DENSE ) RETURN IF ( ProductRank <= 10, [Gross Positive Line Sales GBP] )
		formatString: £#,##0.00;[Red]-£#,##0.00;£0.00

	measure 'Top 10 Country Sales GBP' = VAR CountryRank = RANKX ( ALL ( DimCountry[country] ), [Gross Positive Line Sales GBP], , DESC, DENSE ) RETURN IF ( CountryRank <= 10, [Gross Positive Line Sales GBP] )
		formatString: £#,##0.00;[Red]-£#,##0.00;£0.00

	column source_row_id
		dataType: int64
		isKey
		isHidden
		summarizeBy: none
		sourceColumn: source_row_id

		annotation SummarizationSetBy = Automatic

	column invoice_no
		dataType: string
		summarizeBy: none
		sourceColumn: invoice_no

		annotation SummarizationSetBy = Automatic

	column stock_code
		dataType: string
		summarizeBy: none
		sourceColumn: stock_code

		annotation SummarizationSetBy = Automatic

	column quantity
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: quantity

		annotation SummarizationSetBy = Automatic

	column invoice_date
		dataType: dateTime
		formatString: yyyy-MM-dd HH:mm:ss
		summarizeBy: none
		sourceColumn: invoice_date

		annotation SummarizationSetBy = Automatic

	column unit_price
		dataType: double
		formatString: £#,##0.00;[Red]-£#,##0.00;£0.00
		summarizeBy: sum
		sourceColumn: unit_price

		annotation SummarizationSetBy = Automatic

	column customer_id
		dataType: string
		summarizeBy: none
		sourceColumn: customer_id

		annotation SummarizationSetBy = Automatic

	column country
		dataType: string
		summarizeBy: none
		sourceColumn: country

		annotation SummarizationSetBy = Automatic

	column line_value
		dataType: double
		formatString: £#,##0.00;[Red]-£#,##0.00;£0.00
		summarizeBy: sum
		sourceColumn: line_value

		annotation SummarizationSetBy = Automatic

	column is_cancellation_invoice
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_cancellation_invoice

		annotation SummarizationSetBy = Automatic

	column is_positive_sales_line
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_positive_sales_line

		annotation SummarizationSetBy = Automatic

	column is_customer_analytics_eligible
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_customer_analytics_eligible

		annotation SummarizationSetBy = Automatic

	column is_negative_quantity
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_negative_quantity

		annotation SummarizationSetBy = Automatic

	column is_negative_line_value
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_negative_line_value

		annotation SummarizationSetBy = Automatic

	column is_exact_duplicate_extra_row
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_exact_duplicate_extra_row

		annotation SummarizationSetBy = Automatic

	column is_credit_or_return_like
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_credit_or_return_like

		annotation SummarizationSetBy = Automatic

	column InvoiceDateDate
		dataType: date
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: InvoiceDateDate

		annotation SummarizationSetBy = Automatic

	partition FactSalesLine = m
		mode: import
		queryGroup: Tables
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectRoot & "/data/processed/fact_sales_lines.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    SelectedColumns = Table.SelectColumns(PromotedHeaders, {"source_row_id", "invoice_no", "stock_code", "quantity", "invoice_date", "unit_price", "customer_id", "country", "line_value", "is_cancellation_invoice", "is_positive_sales_line", "is_customer_analytics_eligible", "is_negative_quantity", "is_negative_line_value", "is_exact_duplicate_extra_row", "is_credit_or_return_like"}, MissingField.Error),
				    ChangedTypes = Table.TransformColumnTypes(SelectedColumns, {{"source_row_id", Int64.Type}, {"invoice_no", type text}, {"stock_code", type text}, {"quantity", Int64.Type}, {"invoice_date", type datetime}, {"unit_price", type number}, {"customer_id", type text}, {"country", type text}, {"line_value", type number}, {"is_cancellation_invoice", type logical}, {"is_positive_sales_line", type logical}, {"is_customer_analytics_eligible", type logical}, {"is_negative_quantity", type logical}, {"is_negative_line_value", type logical}, {"is_exact_duplicate_extra_row", type logical}, {"is_credit_or_return_like", type logical}}, "en-GB"),
				    AddInvoiceDateDate = Table.AddColumn(ChangedTypes, "InvoiceDateDate", each if [invoice_date] = null then null else Date.From([invoice_date]), type date)
				in
				    AddInvoiceDateDate

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
