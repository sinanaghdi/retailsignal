table CohortRetention

	column cohort_month
		dataType: dateTime
		formatString: yyyy-MM
		summarizeBy: none
		sourceColumn: cohort_month

		annotation SummarizationSetBy = Automatic

	column activity_month
		dataType: dateTime
		formatString: yyyy-MM
		summarizeBy: none
		sourceColumn: activity_month

		annotation SummarizationSetBy = Automatic

	column cohort_index
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: cohort_index

		annotation SummarizationSetBy = Automatic

	column active_customers
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: active_customers

		annotation SummarizationSetBy = Automatic

	column cohort_size
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: cohort_size

		annotation SummarizationSetBy = Automatic

	column retention_rate
		dataType: double
		formatString: 0.0%;[Red]-0.0%;0.0%
		summarizeBy: sum
		sourceColumn: retention_rate

		annotation SummarizationSetBy = Automatic

	partition CohortRetention = m
		mode: import
		queryGroup: Tables
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectRoot & "/data/marts/cohort_retention.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    SelectedColumns = Table.SelectColumns(PromotedHeaders, {"cohort_month", "activity_month", "cohort_index", "active_customers", "cohort_size", "retention_rate"}, MissingField.Error),
				    ChangedTypes = Table.TransformColumnTypes(SelectedColumns, {{"cohort_month", type datetime}, {"activity_month", type datetime}, {"cohort_index", Int64.Type}, {"active_customers", Int64.Type}, {"cohort_size", Int64.Type}, {"retention_rate", type number}}, "en-GB")
				in
				    ChangedTypes

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
