table DimProduct

	column stock_code
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: stock_code

		annotation SummarizationSetBy = Automatic

	column description
		dataType: string
		summarizeBy: none
		sourceColumn: description

		annotation SummarizationSetBy = Automatic

	column source_line_count
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: source_line_count

		annotation SummarizationSetBy = Automatic

	partition DimProduct = m
		mode: import
		queryGroup: Tables
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectRoot & "/data/marts/dim_product.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    SelectedColumns = Table.SelectColumns(PromotedHeaders, {"stock_code", "description", "source_line_count"}, MissingField.Error),
				    ChangedTypes = Table.TransformColumnTypes(SelectedColumns, {{"stock_code", type text}, {"description", type text}, {"source_line_count", Int64.Type}}, "en-GB")
				in
				    ChangedTypes

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
