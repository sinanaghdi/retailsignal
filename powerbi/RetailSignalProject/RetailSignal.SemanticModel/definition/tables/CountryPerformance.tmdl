table CountryPerformance

	column country
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: country

		annotation SummarizationSetBy = Automatic

	column gross_positive_line_sales_gbp
		dataType: double
		formatString: £#,##0.00;[Red]-£#,##0.00;£0.00
		summarizeBy: sum
		sourceColumn: gross_positive_line_sales_gbp

		annotation SummarizationSetBy = Automatic

	column units_sold_positive
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: units_sold_positive

		annotation SummarizationSetBy = Automatic

	column invoice_count
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: invoice_count

		annotation SummarizationSetBy = Automatic

	column identified_customers
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: identified_customers

		annotation SummarizationSetBy = Automatic

	column sales_contribution_pct
		dataType: double
		formatString: 0.0
		summarizeBy: sum
		sourceColumn: sales_contribution_pct

		annotation SummarizationSetBy = Automatic

	partition CountryPerformance = m
		mode: import
		queryGroup: Tables
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectRoot & "/data/marts/country_performance.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    SelectedColumns = Table.SelectColumns(PromotedHeaders, {"country", "gross_positive_line_sales_gbp", "units_sold_positive", "invoice_count", "identified_customers", "sales_contribution_pct"}, MissingField.Error),
				    ChangedTypes = Table.TransformColumnTypes(SelectedColumns, {{"country", type text}, {"gross_positive_line_sales_gbp", type number}, {"units_sold_positive", Int64.Type}, {"invoice_count", Int64.Type}, {"identified_customers", Int64.Type}, {"sales_contribution_pct", type number}}, "en-GB")
				in
				    ChangedTypes

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
